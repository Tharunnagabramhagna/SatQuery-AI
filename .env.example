# ==============================================================================
# SatQuery AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or secret keys to version control.
# ==============================================================================

# PostgreSQL Connection URLs (psycopg 3 driver: postgresql+psycopg://)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/satquery
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/satquery_test

# CORS Allowed Origins (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication Settings
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend and Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# SMTP Email Delivery Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@satquery.ai
SMTP_FROM_NAME="SatQuery AI"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Meta / Facebook Login (https://developers.facebook.com/)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback

# Google Gemini Query Understanding (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
