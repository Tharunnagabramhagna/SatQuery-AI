# ==============================================================================
# SatQuery AI — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or secret keys to version control.
# ==============================================================================

# PostgreSQL Connection URLs (psycopg 3 driver: postgresql+psycopg://)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/satquery
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/satquery_test

# CORS Allowed Origins (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication Settings
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
